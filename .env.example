# Polymarket API endpoints (públicos, no requieren key)
GAMMA_API=https://gamma-api.polymarket.com
CLOB_API=https://clob.polymarket.com
DATA_API=https://data-api.polymarket.com

# Base de datos local
DB_PATH=data/copybot.db

# Logging
LOG_LEVEL=INFO

# --- Paper / risk management ---
# Capital total del bot (cap duro: nunca abre más allá de esto)
BOT_CAPITAL_USDC=100.0
# Apuesta base por copia (antes del sizing_mult)
COPY_BASE_USDC=5.0
# Polling por wallet (segundos)
COPY_POLL_SECONDS=10

# Stop-loss por posición: cierra si precio cae X%  por debajo del entry
STOP_LOSS_PCT=0.30
# Take-profit opcional: cierra si precio sube X%  desde el entry (0 = desactivado)
TAKE_PROFIT_PCT=0.80
# Cap de exposición por mercado (% del capital total)
MAX_PER_MARKET_PCT=0.20
# Liquidez mínima del mercado para considerar la copia ($)
MIN_MARKET_LIQUIDITY_USDC=5000
# Volumen mínimo del mercado para considerar la copia ($)
MIN_MARKET_VOLUME_USDC=10000
# Kill switch: si el PnL del día cae por debajo de -X% del capital, pausa todo
DAILY_KILL_SWITCH_PCT=0.10
# Frecuencia del sweep de stop-loss (segundos)
STOPLOSS_SWEEP_SECONDS=60

# --- Realismo (simula slippage + fees + gas como en plata real) ---
REALISTIC_MODE=true
REALISM_ENTRY_SLIP_PCT=0.015          # 1.5% slippage base en entries
REALISM_EXIT_SLIP_PCT=0.015           # 1.5% slippage base en exits
REALISM_SL_SLIP_MULT=2.0              # x2 slippage en stop-loss (mercado cayendo)
REALISM_LONGSHOT_SLIP_PCT=0.04        # +4% en entries con price <0.15 o >0.85
REALISM_LOWLIQ_SLIP_PCT=0.03          # +3% si liquidity <$10k
REALISM_LOWLIQ_THRESHOLD_USDC=10000
REALISM_FEE_PCT=0.02                  # 2% de Polymarket sobre wins
REALISM_GAS_USDC=0.02                 # gas Polygon por tx

# --- Telegram notifications (opcional) ---
# 1. En Telegram: hablale a @BotFather → /newbot → seguís los pasos → te da el token
# 2. Hablale a tu bot recién creado (mandá "/start")
# 3. Pegá el token acá ↓
TELEGRAM_BOT_TOKEN=
# 4. Corré: python copybot.py telegram-setup → te dice tu chat_id
# 5. Pegá el chat_id acá ↓
TELEGRAM_CHAT_ID=

# --- Fase 5: Live trading (plata real en Polymarket) ---
# Default: paper. Cambiar a true SOLO cuando estés listo para mandar órdenes reales.
LIVE_MODE=false

# Si LIVE_MODE=true, este flag controla si las órdenes se mandan al CLOB o solo se loguean.
# Default true (dry-run) para que sea imposible mandar plata real "por accidente".
# Cambiar a false (o usar `python copybot.py run-live --real --yes`) para órdenes reales.
LIVE_DRY_RUN=true

# Capital operativo del bot en plata real (USDC).
# Es el cap del bot, NO el balance total de tu wallet.
LIVE_CAPITAL_USDC=50.0
# Apuesta base por copia en modo live (suele ser menor que en paper).
LIVE_BASE_USDC=2.5

# Polymarket CLOB credentials.
# Generar con: python scripts/generate_api_creds.py
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Tu proxy wallet de Polymarket (la dirección que ves en polymarket.com → Deposit)
POLYMARKET_FUNDER_ADDRESS=
# Tipo de firma: 2=POLY_GNOSIS_SAFE (default, cuenta creada con email/Magic).
# Cambiar a 0 si usás una EOA standalone (MetaMask sin proxy).
POLYMARKET_SIG_TYPE=2
# Private key: OPCIONAL. Solo necesaria si tenés que regenerar API creds o
# firmar L1 ops. Para placement de órdenes con creds L2 NO es necesaria.
# Si la ponés acá, queda en .env (que NO va a Git, pero igual: es sensible).
# POLYMARKET_PRIVATE_KEY=

# --- Mejoras anti-fricción para live ---
# Cap por wallet copiado (forzosa diversificación). Default $10 sobre cap $30 → max 3 wallets.
LIVE_MAX_PER_WALLET_USDC=10.0
# Mínimo PnL esperado para que el trade valga la pena (filtro anti-fees).
LIVE_MIN_EXPECTED_PNL_USDC=0.50
# Slippage máximo aceptable según orderbook (3% default). Si > esto → no entra.
LIVE_MAX_SLIPPAGE_PCT=0.03
# Bump de precio en el retry IOC. Si la primera orden no fillea, re-intenta a este % peor.
LIVE_RETRY_PRICE_BUMP_PCT=0.01

# Calibración del realismo (afecta paper Y live)
REALISM_GAS_USDC=0.05                # Polygon CTF Exchange real ~$0.04-0.08
REALISM_EXPECTED_WIN_RATE=0.32       # observado en paper trading (32%)
REALISM_EXPECTED_WIN_GAIN_MULT=1.0   # ganancia bruta promedio sobre size en wins
